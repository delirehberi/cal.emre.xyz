# ==============================================================================
# cal.emre.xyz Environment Variables Template
# ==============================================================================
# Copy this file to .dev.vars for local Cloudflare Worker development or configure
# these variables in your Cloudflare Workers Dashboard / wrangler.jsonc.

# Flag to enable or disable transactional email notifications (true | false)
ENABLE_EMAIL_NOTIFICATIONS=false

# Resend API Key for sending transactional booking confirmation emails
# Required if ENABLE_EMAIL_NOTIFICATIONS is set to true
# Obtain from https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Default Host NIP-05 identifier shown on the root path '/'
DEFAULT_HOST_NIP05=delirehberi@emre.xyz

# Default Host 32-byte hex public key (derived from npub)
DEFAULT_HOST_PUBKEY=46f3c7bb33cc3019049b76dc89dbb96e34c247bdda68b6ad8632682793ff8a1a

# Support email displayed in the application header and mailto links
SUPPORT_EMAIL=z@emre.xyz

# Admin email where copies of all booking reservations are dispatched
ADMIN_EMAIL=z@emre.xyz
